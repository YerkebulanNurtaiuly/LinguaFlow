# Copy to backend/.env for local development (loaded automatically in the dev profile,
# when the app runs with backend/ as working directory). Never commit the real .env.
#
# In prod these must be set as real environment variables; startup fails if any of
# DB_URL, DB_USERNAME, DB_PASSWORD or JWT_SECRET is missing.

# Profile: dev (default) | prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/linguaflow
DB_USERNAME=linguaflow
DB_PASSWORD=change-me

# JWT signing key: at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Anthropic API key (AI-01). Dev: optional; empty = offline fake AI client. Prod: required.
AI_API_KEY=
# Optional: auto (default; Anthropic when a key is set) | fake | anthropic
AI_PROVIDER=

# Browser origins allowed to call the API cross-origin (comma-separated).
# Dev default: http://localhost:5173,http://localhost:3000. Leave empty when nginx serves
# the frontend from the same origin.
CORS_ALLOWED_ORIGINS=

# Public URL of the frontend; links in emails (verification, password reset) point here
FRONTEND_URL=http://localhost:5173
