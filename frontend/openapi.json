          "title" : {
            "type" : "string",
            "example" : "Validation failed"
          },
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Problem type URI",
            "example" : "about:blank"
          }
        },
        "required" : [ "code", "correlationId", "detail", "instance", "status", "timestamp", "title" ]
      },
