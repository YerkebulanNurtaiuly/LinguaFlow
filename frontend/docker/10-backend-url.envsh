#!/bin/sh
# Sourced by the nginx image's entrypoint before the config templates are rendered
# (OPS-02). It accepts BACKEND_URL with or without a scheme: Render's fromService
# hostport gives "linguaflow-api-xyz:8080", and Compose's default is
# "http://backend:8080". It also makes sure a DNS resolver is known, because the API
# upstream is resolved per request: a platform's internal addresses change on redeploys.

case "${BACKEND_URL:-}" in
  "") BACKEND_URL="http://backend:8080" ;;
  *://*) ;;
  *) BACKEND_URL="http://${BACKEND_URL}" ;;
esac
export BACKEND_URL

if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN { ORS = " " } $1 == "nameserver" { print ($2 ~ ":") ? "[" $2 "]" : $2 }' /etc/resolv.conf)
  NGINX_LOCAL_RESOLVERS=${NGINX_LOCAL_RESOLVERS% }
  export NGINX_LOCAL_RESOLVERS
fi
